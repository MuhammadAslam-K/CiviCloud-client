{
    "compilerOptions": {
        "baseUrl": "./",
        "paths": {
            "@components/*": [
                "src/components/*"
            ],
            "@modules/*": [
                "src/modules/*"
            ],
            "@layouts/*": [
                "src/layouts/*"
            ],
            "@routers/*": [
                "src/routers/*"
            ],
            "@utils/*": [
                "src/utils/*"
            ],
            "@constants/*": [
                "src/constants/*"
            ],
        }
    }
}